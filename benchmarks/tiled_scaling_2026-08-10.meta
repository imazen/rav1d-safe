  scripts/perf/tiled_taskprobe_report.py <probedir>
  scripts/perf/tiled_stage_delta.py  <probedir> [4|2]
  scripts/perf/tiled_prof.sh        ~/tmp/tiledprof/prof 30
  scripts/perf/tiled_prof_report.py <profdir>
  scripts/perf/tiled_wallcpu.sh     <out.tsv> 7      (ARMS/CELLS via env)
  scripts/perf/tiled_wallcpu_report.py <out.tsv>
  scripts/perf/tiled_inloop_ab.sh   <out.tsv> 5   (INLOOPS via env)
  scripts/perf/tiled_inloop_report.py <out.tsv>

