# DisjointMut crate commands

# Run unit tests
test:
    cargo test

# Run tests under Miri with Stacked Borrows (default)
miri:
    cargo +nightly miri test

# Run tests under Miri with Tree Borrows
miri-tree:
    MIRIFLAGS="-Zmiri-tree-borrows" cargo +nightly miri test

# Run both aliasing models
miri-all: miri miri-tree

# Check with clippy
clippy:
    cargo clippy -- -D warnings

# Format code
fmt:
    cargo fmt

# Format check
fmt-check:
    cargo fmt --check

# Feature permutation checks — mirrors .github/workflows/disjoint-mut-ci.yml.
# There is deliberately no --all-features leg: `untracked` disables tracking by
# construction and `__probe_count` conflicts with `__probe_usage` (compile_error).
feature-check:
    cargo test --no-default-features
    cargo test --lib --features std,__probe_count,__probe_sites
    cargo test --features aligned,pic-buf
    cargo test --features __probe_wide --test wide_exclusion

# Run all CI checks locally
ci: fmt-check clippy test feature-check
